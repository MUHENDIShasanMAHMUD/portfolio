---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hasan Mahmud — Mechatronics & Embedded Systems Engineer">

  <!-- ================= TAB 1: HOME ================= -->
  <section id="tab-home" class="tab-content">
    
    <!-- Hero Section (Static / No Hover Jump) -->
    <div class="pt-4 pb-8 max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 mb-4 uppercase tracking-wide">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
        <span data-tr="MEKATRONİK & GÖMÜLÜ SİSTEMLER" data-en="MECHATRONICS & EMBEDDED" data-ar="ميكاترونكس وأنظمة مدمجة">MEKATRONİK & GÖMÜLÜ SİSTEMLER</span>
      </div>

      <h1
        class="text-3xl md:text-5xl font-extrabold text-white leading-tight tracking-tight mb-5"
        data-tr="Donanım hassasiyeti ile <span class='text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400'>yazılım mimarisini</span> buluşturuyorum."
        data-en="Integrating Hardware Precision with <span class='text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400'>Software Architecture</span>."
        data-ar="أهندس تكاملاً دقيقاً بين عتاد الأنظمة المدمجة و<span class='text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400'>المعمارية البرمجية</span>."
      >
        Donanım hassasiyeti ile <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400">yazılım mimarisini</span> buluşturuyorum.
      </h1>

      <p
        class="text-base text-slate-300 leading-relaxed max-w-3xl mb-8"
        data-tr="Necmettin Erbakan Üniversitesi Mekatronik Mühendisliği mezunuyum. Gömülü sistemler, mikrodenetleyici mimarileri (STM32, ESP32) ve IoT haberleşme altyapıları üzerine 1.5 yıllık uygulamalı Ar-Ge deneyimine sahibim."
        data-en="Mechatronics Engineering graduate from Necmettin Erbakan University with 1.5 years of practical R&D experience in embedded systems, microcontroller architectures (STM32, ESP32), and IoT telemetry platforms."
        data-ar="خريج هندسة الميكاترونكس من جامعة نجم الدين أربكان. أمتلك 1.5 سنة من الخبرة العملية في البحث والتطوير وهندسة البرمجيات المدمجة (STM32، ESP32) وتكامل العتاد وبنى إنترنت الأشياء IoT."
      >
        Necmettin Erbakan Üniversitesi Mekatronik Mühendisliği mezunuyum. Gömülü sistemler, mikrodenetleyici mimarileri (STM32, ESP32) ve IoT haberleşme altyapıları üzerine 1.5 yıllık uygulamalı Ar-Ge deneyimine sahibim.
      </p>

      <div class="flex gap-4 flex-wrap">
        <button
          type="button"
          onclick="window.switchTab('tab-projects')"
          class="bg-teal-500 hover:bg-teal-400 text-slate-950 px-6 py-3 rounded-xl font-bold text-sm transition-all cursor-pointer shadow-lg shadow-teal-500/20"
        >
          <span data-tr="Projeleri Gör" data-en="Explore Projects" data-ar="استعراض المشاريع">Projeleri Gör</span> →
        </button>
        <button
          type="button"
          onclick="window.switchTab('tab-contact')"
          class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 px-6 py-3 rounded-xl font-bold text-sm transition-colors cursor-pointer"
        >
          <span data-tr="İletişime Geç" data-en="Get in Touch" data-ar="تواصل معي">İletişime Geç</span>
        </button>
      </div>
    </div>

    <!-- Infinite Auto-Moving Marquee (Claude Original Fluid Track) -->
    <div class="marquee-wrapper mb-10">
      <div class="marquee-slider">
        <span class="marquee-badge"><span class="badge-dot"></span>STM32G030</span>
        <span class="marquee-badge"><span class="badge-dot"></span>ESP32</span>
        <span class="marquee-badge"><span class="badge-dot"></span>Bare-Metal C/C++</span>
        <span class="marquee-badge"><span class="badge-dot"></span>RS-485 / Modbus</span>
        <span class="marquee-badge"><span class="badge-dot"></span>BLE &amp; Web Serial</span>
        <span class="marquee-badge"><span class="badge-dot"></span>FreeRTOS</span>
        <span class="marquee-badge"><span class="badge-dot"></span>TDMA Protocol</span>
        <span class="marquee-badge"><span class="badge-dot"></span>OTA Firmware</span>
        <span class="marquee-badge"><span class="badge-dot"></span>AI Vibe Coding</span>

        <!-- Duplicated Stream for Continuous Loop -->
        <span class="marquee-badge"><span class="badge-dot"></span>STM32G030</span>
        <span class="marquee-badge"><span class="badge-dot"></span>ESP32</span>
        <span class="marquee-badge"><span class="badge-dot"></span>Bare-Metal C/C++</span>
        <span class="marquee-badge"><span class="badge-dot"></span>RS-485 / Modbus</span>
        <span class="marquee-badge"><span class="badge-dot"></span>BLE &amp; Web Serial</span>
        <span class="marquee-badge"><span class="badge-dot"></span>FreeRTOS</span>
        <span class="marquee-badge"><span class="badge-dot"></span>TDMA Protocol</span>
        <span class="marquee-badge"><span class="badge-dot"></span>OTA Firmware</span>
        <span class="marquee-badge"><span class="badge-dot"></span>AI Vibe Coding</span>
      </div>
    </div>

    <!-- 4 Metrics Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="interactive-card p-6">
        <div class="text-3xl font-extrabold text-teal-400 font-['JetBrains_Mono']">1.5+</div>
        <div class="text-xs font-semibold text-slate-300 mt-2" data-tr="Yıl Pratik Ar-Ge" data-en="Years Practical R&D" data-ar="سنوات خبرة بحث وتطوير">Yıl Pratik Ar-Ge</div>
      </div>
      <div class="interactive-card p-6">
        <div class="text-3xl font-extrabold text-teal-400 font-['JetBrains_Mono']">TÜBİTAK</div>
        <div class="text-xs font-semibold text-slate-300 mt-2" data-tr="Ulusal Ar-Ge Onayı" data-en="National Acceptance" data-ar="اعتماد مشاريع وطنية">Ulusal Ar-Ge Onayı</div>
      </div>
      <div class="interactive-card p-6">
        <div class="text-3xl font-extrabold text-teal-400 font-['JetBrains_Mono']">Bare-Metal</div>
        <div class="text-xs font-semibold text-slate-300 mt-2" data-tr="STM32 &amp; UART ISR" data-en="STM32 &amp; UART ISR" data-ar="مشغلات منخفضة المستوى">STM32 &amp; UART ISR</div>
      </div>
      <div class="interactive-card p-6">
        <div class="text-3xl font-extrabold text-teal-400 font-['JetBrains_Mono']">IoT &amp; OTA</div>
        <div class="text-xs font-semibold text-slate-300 mt-2" data-tr="ESP32 ve BLE Ağları" data-en="ESP32 &amp; BLE Telemetry" data-ar="تحكم ومزامنة لاسلكية">ESP32 ve BLE Ağları</div>
      </div>
    </div>

    <!-- Featured Systems -->
    <div>
      <h2 class="text-xl font-extrabold text-white mb-5" data-tr="Öne Çıkan Sistemler" data-en="Featured Systems" data-ar="الأنظمة الأبرز">Öne Çıkan Sistemler</h2>

      <div class="grid md:grid-cols-2 gap-5">
        <div class="interactive-card p-7 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-teal-400 uppercase tracking-wide font-['JetBrains_Mono']">ARM Cortex-M0+ &amp; Sürücüler</span>
            <h3 class="text-lg font-bold text-white mt-2 mb-3">PT500 Motor Sürücü Sistemi</h3>
            <p
              class="text-sm text-slate-300 leading-relaxed"
              data-tr="STM32G030 mikrodenetleyicisi, RS-485 ve nRF24L01+ tabanlı motor sürücü entegrasyonu. TDMA veri çarpışma önleme algoritmaları ve Bare-metal UART sürücü mimarisi."
              data-en="STM32G030 and RS-485 based motor driver system integration. Includes TDMA collision-avoidance algorithms and bare-metal UART ring buffer drivers."
              data-ar="نظام قيادة محركات يعتمد على STM32G030 و RS-485 مع خوارزميات TDMA لمنع تصادم البيانات ومشغلات UART المستقلة مع مخازن حلقية."
            >
              STM32G030 mikrodenetleyicisi, RS-485 ve nRF24L01+ tabanlı motor sürücü entegrasyonu. TDMA veri çarpışmasını önleyen algoritmalar ve Bare-metal UART sürücü mimarisi.
            </p>
          </div>
          <div class="flex gap-2 flex-wrap mt-6 pt-4 border-t border-slate-800">
            <span class="system-pill">STM32G030</span>
            <span class="system-pill">RS-485</span>
            <span class="system-pill">TDMA</span>
          </div>
        </div>

        <div class="interactive-card p-7 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-teal-400 uppercase tracking-wide font-['JetBrains_Mono']">ESP32 &amp; IoT Donanım</span>
            <h3 class="text-lg font-bold text-white mt-2 mb-3">KTS200 Karavan Otomatik Terazileme</h3>
            <p
              class="text-sm text-slate-300 leading-relaxed"
              data-tr="ESP32 merkezli 9 fazlı durum makinesi (state machine) akışları, eğim/ivme sensörü verilerinin filtrelenmesi, Web Serial ve BLE haberleşmesi ile uzaktan kablosuz yazılım yükleme (OTA) altyapısı."
              data-en="ESP32-based 9-phase state machine architecture, Web Serial & BLE telemetry, and wireless Over-The-Air (OTA) firmware upgrade infrastructure."
              data-ar="نظام تسوية آلي بآلة حالة من 9 مراحل على ESP32، ومزامنة BLE و Web Serial وتحديث البرامج الثابتة لاسلكياً (OTA)."
            >
              ESP32 merkezli 9 fazlı durum makinesi (state machine) akışları, eğim/ivme sensörü verilerinin filtrelenmesi, Web Serial ve BLE haberleşmesi ile uzaktan kablosuz yazılım güncelleme (OTA) altyapısı.
            </p>
          </div>
          <div class="flex gap-2 flex-wrap mt-6 pt-4 border-t border-slate-800">
            <span class="system-pill">ESP32</span>
            <span class="system-pill">BLE</span>
            <span class="system-pill">OTA Firmware</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TAB 2: RESUME ================= -->
  <section id="tab-resume" class="tab-content hidden">
    
    <div class="pb-5 border-b border-slate-800 mb-8 flex justify-between items-end flex-wrap gap-2">
      <div>
        <h2 class="text-2xl font-extrabold text-white" data-tr="Mühendislik Özgeçmişi" data-en="Engineering Resume" data-ar="السيرة الذاتية المهنية">Mühendislik Özgeçmişi</h2>
        <span class="text-xs text-teal-400 font-['JetBrains_Mono'] font-bold">HASAN MAHMUD — MECHATRONICS &amp; EMBEDDED</span>
      </div>
      <span class="text-xs text-slate-400 font-['JetBrains_Mono']">1.5+ YIL AR-GE DENEYİMİ</span>
    </div>

    <!-- Experience Section with Interactive Cards -->
    <div class="space-y-4 mb-8">
      <h3 class="text-xs font-bold text-teal-400 tracking-wider uppercase mb-2" data-tr="// İŞ VE AR-GE DENEYİMİ" data-en="// WORK EXPERIENCE" data-ar="// الخبرة المهنية والبحث والتطوير">// İŞ VE AR-GE DENEYİMİ</h3>
      
      <!-- AXI Teknoloji Card -->
      <div class="interactive-card p-7">
        <div class="flex justify-between items-start flex-wrap gap-2 mb-2">
          <div>
            <h4 class="text-lg font-bold text-white" data-tr="Mekatronik Mühendisi (Ortak Eğitim &amp; Ar-Ge Yöneticisi)" data-en="Mechatronics Engineer (Co-op Education & R&D Manager)" data-ar="مهندس ميكاترونكس (تدريب تعاوني ومدير بحث وتطوير)">Mekatronik Mühendisi (Ortak Eğitim &amp; Ar-Ge Yöneticisi)</h4>
            <div class="text-sm font-semibold text-teal-400 mt-0.5">AXI Teknoloji | İstanbul, Türkiye</div>
          </div>
          <span class="text-xs text-slate-300 font-['JetBrains_Mono'] bg-slate-900 border border-slate-700/80 px-3 py-1.5 rounded-lg">Ocak 2025 - Temmuz 2026</span>
        </div>
        <ul class="text-slate-300 text-sm leading-8 list-disc ps-5 space-y-1.5 pt-3 border-t border-slate-800">
          <li data-tr="Akıllı kontrol sistemleri ve gömülü yazılımlar üzerine uçtan uca donanım ve yazılım entegrasyonu süreçlerini yönetti." data-en="Managed end-to-end hardware and software integration processes on Smart Control Systems and Embedded Software." data-ar="إدارة عمليات تكامل الأجهزة والبرمجيات من البداية إلى النهاية في أنظمة التحكم الذكية والبرمجيات المدمجة.">
            Akıllı kontrol sistemleri ve gömülü yazılımlar üzerine uçtan uca donanım ve yazılım entegrasyonu süreçlerini yönetti.
          </li>
          <li data-tr="TÜBİTAK destekli ulusal Ar-Ge projesinde teknik gereksinim analizlerini tamamlayarak kabul onay sürecine liderlik etti." data-en="Served as project engineer in a prestigious national R&D project supported by TÜBİTAK; completed requirements analysis and led formal acceptance approval." data-ar="العمل كمهندس مشروع في مشروع بحث وتطوير وطني مدعوم من TÜBİTAK، وإتمام تحليلات المتطلبات وقيادة القبول الرسمي.">
            TÜBİTAK destekli ulusal Ar-Ge projesinde teknik gereksinim analizlerini tamamlayarak kabul onay sürecine liderlik etti.
          </li>
          <li data-tr="Mikrodenetleyici mimarileri kullanarak sensör veri toplama ve kablosuz telemetri altyapılarını tasarladı ve optimize etti." data-en="Designed and optimized sensor data acquisition and wireless telemetry infrastructures using microcontroller architectures." data-ar="تصميم وتحسين البنى التحتية لجمع بيانات المستشعرات والقياس عن بعد اللاسلكي عبر معماريات المتحكمات الدقيقة.">
            Mikrodenetleyici mimarileri kullanarak sensör veri toplama ve kablosuz telemetri altyapılarını tasarladı ve optimize etti.
          </li>
        </ul>
      </div>

      <!-- TEKNOFEST Card -->
      <div class="interactive-card p-7">
        <div class="flex justify-between items-start flex-wrap gap-2 mb-2">
          <div>
            <h4 class="text-lg font-bold text-white" data-tr="Aviyonik / Sistem Tasarım Ekip Üyesi (TEKNOFEST İHA)" data-en="Avionics / System Design Team Member (TEKNOFEST UAV)" data-ar="عضو فريق تصميم إلكترونيات الطيران (TEKNOFEST للطائرات المسيرة)">Aviyonik / Sistem Tasarım Ekip Üyesi (TEKNOFEST İHA)</h4>
            <div class="text-sm font-semibold text-teal-400 mt-0.5">Üniversite Proje Takımı | Konya, Türkiye</div>
          </div>
          <span class="text-xs text-slate-300 font-['JetBrains_Mono'] bg-slate-900 border border-slate-700/80 px-3 py-1.5 rounded-lg">Ekim 2023 - Mart 2024</span>
        </div>
        <p class="text-slate-300 text-sm leading-relaxed pt-3 border-t border-slate-800" data-tr="TEKNOFEST İHA projesinin kavramsal tasarım ve alt sistem planlama süreçlerinde görev aldı. Otonom uçuş gereksinimleri doğrultusunda donanım bileşenlerinin seçimi ve teknik fizibilite çalışmalarına katkı sağladı." data-en="Took an active role in conceptual design and sub-system planning of the UAV project. Contributed to hardware selection and feasibility studies matching autonomous flight requirements." data-ar="المشاركة في التصميم المفاهيمي وتخطيط الأنظمة الفرعية لمشروع الطائرة المسيرة (IHA) ضمن TEKNOFEST والمساهمة في دراسات الجدوى واختيار مكونات العتاد.">
          TEKNOFEST İHA projesinin kavramsal tasarım ve alt sistem planlama süreçlerinde görev aldı. Otonom uçuş gereksinimleri doğrultusunda donanım bileşenlerinin seçimi ve fizibilite çalışmalarına katkı sağladı.
        </p>
      </div>

      <!-- Sağır Otomotiv Card -->
      <div class="interactive-card p-7">
        <div class="flex justify-between items-start flex-wrap gap-2 mb-2">
          <div>
            <h4 class="text-lg font-bold text-white" data-tr="Operasyon ve Veri Yönetimi Asistanı" data-en="Operations & Data Management Assistant" data-ar="مساعد عمليات وإدارة بيانات">Operasyon ve Veri Yönetimi Asistanı</h4>
            <div class="text-sm font-semibold text-teal-400 mt-0.5">Sağır Otomotiv (Tenax Yetkili Servis) | İstanbul</div>
          </div>
          <span class="text-xs text-slate-300 font-['JetBrains_Mono'] bg-slate-900 border border-slate-700/80 px-3 py-1.5 rounded-lg">ERP &amp; Operasyon</span>
        </div>
        <p class="text-slate-300 text-sm leading-relaxed pt-3 border-t border-slate-800" data-tr="Servis içi operasyon verilerini analiz etti, dijital ERP/ön muhasebe kayıtlarının takibini yürüttü ve ticari iş akışlarını optimize etti." data-en="Analyzed operational servicing data, maintained ERP/pre-accounting systems, and accelerated commercial workflows." data-ar="تحليل البيانات التشغيلية والمتابعة المنتظمة لأنظمة التسجيل الرقمية (ERP / المحاسبة الأولية) وتحسين سير العمل.">
          Servis içi operasyon verilerini analiz etti, dijital ERP/ön muhasebe kayıtlarının takibini yürüttü ve ticari iş akışlarını optimize etti.
        </p>
      </div>
    </div>

    <!-- Skills Matrix Grid -->
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      <div class="interactive-card p-6">
        <div class="text-base font-bold text-white mb-3 flex items-center gap-2" data-tr="Haberleşme &amp; Protokoller" data-en="Protocols & Comms" data-ar="الاتصالات والبروتوكولات">
          <span class="w-2.5 h-2.5 rounded-full bg-teal-400"></span> Haberleşme &amp; Protokoller
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="system-pill">UART</span>
          <span class="system-pill">RS-485</span>
          <span class="system-pill">I2C / SPI</span>
          <span class="system-pill">BLE</span>
          <span class="system-pill">Web Serial API</span>
        </div>
      </div>

      <div class="interactive-card p-6">
        <div class="text-base font-bold text-white mb-3 flex items-center gap-2" data-tr="Donanım &amp; Kontrol" data-en="Hardware & Control" data-ar="العتاد والتحكم">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span> Donanım &amp; Kontrol
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="system-pill">STM32G030</span>
          <span class="system-pill">ESP32</span>
          <span class="system-pill">H-Bridge</span>
          <span class="system-pill">EMA Filter</span>
          <span class="system-pill">EEPROM</span>
          <span class="system-pill">PWM / ADC</span>
        </div>
      </div>

      <div class="interactive-card p-6">
        <div class="text-base font-bold text-white mb-3 flex items-center gap-2" data-tr="Yazılım &amp; Araçlar" data-en="Software & Tools" data-ar="البرمجيات وأدوات التطوير">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Yazılım &amp; Araçlar
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="system-pill">C / C++</span>
          <span class="system-pill">Python</span>
          <span class="system-pill">PlatformIO</span>
          <span class="system-pill">STM32CubeIDE</span>
          <span class="system-pill">KiCad</span>
          <span class="system-pill">Git</span>
        </div>
      </div>
    </div>

    <!-- Education Card -->
    <div class="interactive-card p-6">
      <span class="text-xs font-bold text-teal-400 uppercase tracking-wide font-['JetBrains_Mono']">// EĞİTİM</span>
      <h4 class="text-lg font-bold text-white mt-1" data-tr="Mekatronik Mühendisliği (Lisans)" data-en="B.Sc. in Mechatronics Engineering" data-ar="بكالوريوس هندسة الميكاترونكس">Mekatronik Mühendisliği (Lisans)</h4>
      <p class="text-sm text-slate-400 mt-1 font-['JetBrains_Mono']">Necmettin Erbakan Üniversitesi | Konya, Türkiye (2022 - 2026)</p>
    </div>

  </section>

  <!-- ================= TAB 3: PROJECTS ================= -->
  <section id="tab-projects" class="tab-content hidden">
    
    <div class="pb-5 border-b border-slate-800 mb-8">
      <h2 class="text-2xl font-extrabold text-white" data-tr="Mühendislik Projeleri" data-en="Engineering Projects" data-ar="المشاريع الهندسية">Mühendislik Projeleri</h2>
      <p class="text-sm text-slate-400 mt-1" data-tr="Gömülü sistemler, endüstriyel sürücüler ve IoT telemetri mimarileri." data-en="Embedded systems, industrial drivers, and IoT telemetry." data-ar="الأنظمة المدمجة، مشغلات المحركات، وبنى الاتصال عن بعد.">Gömülü sistemler, endüstriyel sürücüler ve IoT telemetri mimarileri.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- PT500 -->
      <div class="interactive-card p-8 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold text-teal-400 uppercase tracking-wide font-['JetBrains_Mono']">ARM Cortex-M0+ &amp; Sürücü</span>
          <h3 class="text-xl font-bold text-white mt-2 mb-3">PT500 Motor Sürücü Sistemi</h3>
          <p
            class="text-sm text-slate-300 leading-relaxed"
