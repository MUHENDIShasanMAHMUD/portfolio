  function getModalLanguage() {
    const language = document.documentElement.getAttribute('lang');
    return ['tr', 'en', 'ar'].includes(language) ? language : 'tr';
  }

  const articleModal = document.getElementById('article-modal');
  const articleCategory = document.getElementById('article-modal-category');
  const articleTitle = document.getElementById('article-modal-title');
  const articleDate = document.getElementById('article-modal-date');
  const articleDescription = document.getElementById('article-modal-description');
  const articlePills = document.getElementById('article-modal-pills');
  let lastArticleTrigger = null;

  function openArticleModal(articleKey, trigger) {
    const article = articleDatabase[articleKey];
    if (!article || !articleModal) return;
    const localizedArticle = modalTranslations.articles[articleKey]?.[getModalLanguage()] || article;

    articleCategory.textContent = localizedArticle.category;
    articleTitle.textContent = localizedArticle.title;
    articleDate.textContent = localizedArticle.date;
    articleDescription.innerHTML = formatProjectDescription(localizedArticle.desc);
    articlePills.innerHTML = localizedArticle.pills.map((pill) => `<span>${pill}</span>`).join('');
    lastArticleTrigger = trigger;
    articleModal.hidden = false;
    document.body.classList.add('modal-open');
    articleModal.querySelector('.project-modal-close').focus();
  }

  function closeArticleModal() {
    if (!articleModal || articleModal.hidden) return;
    articleModal.hidden = true;
    document.body.classList.remove('modal-open');
    lastArticleTrigger?.focus();
  }

  document.querySelectorAll('.article-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => openArticleModal(trigger.dataset.article, trigger));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openArticleModal(trigger.dataset.article, trigger);
      }
    });
  });

  articleModal?.querySelectorAll('[data-article-modal-close]').forEach((element) => {
    element.addEventListener('click', closeArticleModal);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeArticleModal();
  });

  window.addEventListener('languagechange', (event) => {
    const closeLabel = { tr: 'Kapat', en: 'Close', ar: 'إغلاق' }[event.detail] || 'Close';
    document.querySelectorAll('.project-modal-close').forEach((button) => {
      button.setAttribute('aria-label', closeLabel);
    });
    if (!articleModal?.hidden && lastArticleTrigger) {
      openArticleModal(lastArticleTrigger.dataset.article, lastArticleTrigger);
    }
    if (!projectModal?.hidden && lastProjectTrigger) {
      openProjectModal(lastProjectTrigger.dataset.project, lastProjectTrigger);
    }
  });
</script>

<script is:inline>
  const projectDetails = {
    pt500: {
      category: 'ARM Cortex-M0+ & Endüstriyel Sürücü Mimarisi',
      title: 'PT500 Motor Sürücü Sistemi',
      desc: `PT500, endüstriyel hareket kontrolü ve zorlu saha koşulları için STM32G030 (ARM Cortex-M0+) mikrodenetleyicisi temel alınarak sıfırdan geliştirilmiş yüksek performanslı bir motor sürücü ve telemetri mimarisidir.

⚙️ **Derinlemesine Teknik Mimari ve Donanım Entegrasyonu:**

1. **Bare-Metal UART & Ring Buffer Sürücü Mimarisi:**
   HAL (Hardware Abstraction Layer) kütüphanelerinin getirdiği bellek ve zaman aşımı gecikmelerini (overhead) tamamen ortadan kaldırmak için, UART haberleşmesi doğrudan register seviyesinde (Bare-metal) tasarlanmıştır. Kesme tabanlı (ISR) Dairesel Tampon (Circular/Ring Buffer) yapısı sayesinde, yüksek baud rate hızlarında dahi sıfır veri kaybı (packet drop) ile kesintisiz komut alımı sağlanmıştır.

2. **Endüstriyel RS-485 (Half-Duplex) & TDMA Protokolü:**
   Çoklu cihaz senaryolarında (Multi-drop network) veri çakışmalarını (collision) önlemek amacıyla, zaman tabanlı deterministik bir **TDMA (Time Division Multiple Access)** protokol katmanı yazılmıştır. Bu sayede bus üzerindeki her bir sürücü çakışmasız ve sırayla ana kontrolcü ile haberleşir.

3. **Kablosuz Telemetri & nRF24L01+ Entegrasyonu:**
   Kablolu iletişimin kısıtlı olduğu hareketli noktalarda anlık durum takibi, hata ayıklama (debugging) ve uzaktan parametre konfigürasyonu için nRF24L01+ RF modülü sisteme entegre edilmiştir.

4. **Hareket Kontrolü & Güvenlik Mekanizmaları:**
   • H-Bridge sürücü katmanı için yazılımsal **Soft-Start Rampa İvmelenmesi** uygulanarak mekanik darbe (akım piki) engellenmiştir.
   • Donanımsal aşırı akım (over-current) koruması ve MCU içindeki EEPROM emülasyonu ile kritik hata kodları (kritik sıcaklık, voltaj düşüşü, aşırı akım) kalıcı olarak loglanır.`,
