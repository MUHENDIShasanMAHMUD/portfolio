<!-- Copy Handler -->
<script is:inline>
  function copyText(str, btn) {
    navigator.clipboard.writeText(str).then(() => {
      const orig = btn.innerText;
      btn.innerText = 'Kopyalandı!';
      btn.classList.add('bg-teal-500', 'text-slate-950', 'border-teal-400');
      setTimeout(() => {
        btn.innerText = orig;
        btn.classList.remove('bg-teal-500', 'text-slate-950', 'border-teal-400');
      }, 1600);
    });
  }
</script>

