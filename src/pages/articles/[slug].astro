---
import { getCollection, render } from 'astro:content';
import Layout from '../../Layouts/Layout.astro';
import { localizedArticles as translatedArticles } from '../../data/localizedArticles';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const requestedLanguage = Astro.url.searchParams.get('lang');
const initialLanguage = ['tr', 'en', 'ar'].includes(requestedLanguage ?? '') ? requestedLanguage : 'ar';
const articleLanguage = (initialLanguage ?? 'ar') as 'tr' | 'en' | 'ar';
const initialDirection = initialLanguage === 'ar' ? 'rtl' : 'ltr';
const localizedArticles = translatedArticles;
const articleKey = article.id ?? '';
const turkishArticle = localizedArticles.tr[articleKey];
const englishArticle = localizedArticles.en[articleKey];
const dateFormat: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
};
const formattedDates = {
  ar: article.data.date.toLocaleDateString('ar-EG', dateFormat),
  tr: article.data.date.toLocaleDateString('tr-TR', dateFormat),
  en: article.data.date.toLocaleDateString('en-US', dateFormat)
};
---

<Layout title={article.data.title} description={article.data.description}>
  <article class="article-page" dir={initialDirection} lang={initialLanguage} data-article-page>
    <header class="article-page-header">
      <a
        class="article-back-link"
        href="/#tab-articles"
        aria-label="العودة إلى الصفحة الرئيسية"
        data-aria-tr="Ana sayfaya dön"
        data-aria-en="Back to articles"
        data-aria-ar="العودة إلى المقالات"
        data-tr="← Makalelere dön"
        data-en="← Back to articles"
        data-ar="← العودة إلى المقالات"
      >← العودة إلى المقالات</a>
      <p
        class="article-eyebrow"
        data-tr="Hasan TechLab / Teknik vaka çalışması"
        data-en="Hasan TechLab / Technical case study"
        data-ar="Hasan TechLab / دراسة حالة تقنية"
      >Hasan TechLab / دراسة حالة تقنية</p>
      <h1
        data-tr={turkishArticle.title}
        data-en={englishArticle.title}
        data-ar={article.data.title}
      >{article.data.title}</h1>
      <p
        class="article-lede"
        data-tr={turkishArticle.description}
        data-en={englishArticle.description}
        data-ar={article.data.description}
      >{article.data.description}</p>
      <div class="article-meta">
        <time
          datetime={article.data.date.toISOString()}
          data-date-ar={formattedDates.ar}
          data-date-tr={formattedDates.tr}
          data-date-en={formattedDates.en}
        >{formattedDates[articleLanguage]}</time>
        <div class="article-tags">
          {article.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </header>
    <div class="article-content article-lang-content" data-content-language="ar">
      <Content />
    </div>
    <div class="article-content article-lang-content" data-content-language="tr" set:html={turkishArticle.content} hidden></div>
    <div class="article-content article-lang-content" data-content-language="en" set:html={englishArticle.content} hidden></div>
  </article>
</Layout>

<style>
  .article-page { width: 100%; max-width: 900px; min-width: 0; margin: 0 auto; color: #dbe4f0; overflow-wrap: anywhere; }
  .article-page-header { border-bottom: 1px solid #243044; padding: 1rem 0 2.5rem; margin-bottom: 2.5rem; }
  .article-back-link { color: #5eead4; text-decoration: none; font-size: .9rem; }
  .article-back-link:hover { color: #fff; }
  .article-eyebrow { color: #5eead4; font: 700 .75rem/1.5 'JetBrains Mono', monospace; letter-spacing: .08em; margin: 2rem 0 1rem; }
  .article-page h1 { color: #fff; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.2; margin: 0; }
  .article-lede { color: #aab8ca; font-size: 1.1rem; line-height: 2; max-width: 760px; }
  .article-meta { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; color: #8492a6; font-size: .85rem; }
  .article-tags { display: flex; flex-wrap: wrap; gap: .5rem; }
  .article-tags span { border: 1px solid #31505d; border-radius: 999px; color: #8eeadd; padding: .3rem .65rem; }
  .article-content { font-size: 1.05rem; line-height: 2; }
  :global(.article-content h2) { border-right: 3px solid #2dd4bf; color: #fff; font-size: 1.65rem; line-height: 1.5; margin: 3rem 0 1rem; padding-right: .8rem; }
  :global(.article-content h3) { color: #dffcf8; font-size: 1.25rem; line-height: 1.6; margin: 2.2rem 0 .75rem; }
  :global(.article-content p) { color: #c1ccda; margin: 0 0 1.1rem; }
  :global(.article-content strong) { color: #fff; }
  :global(.article-content ul), :global(.article-content ol) { color: #c1ccda; margin: 0 0 1.4rem; padding-right: 1.5rem; }
  :global(.article-content li) { margin: .45rem 0; }
  :global(.article-content code) { background: #111b2b; border: 1px solid #26384f; border-radius: .3rem; color: #8eeadd; padding: .1rem .35rem; overflow-wrap: anywhere; word-break: break-word; }
  :global(.article-content pre) { background: #0a101d; border: 1px solid #243044; border-radius: .6rem; direction: ltr; overflow-x: auto; padding: 1rem; text-align: left; }
  :global(.article-content pre code) { background: transparent; border: 0; color: #d8e7ff; padding: 0; }
  :global(.article-content table) { border-collapse: collapse; display: block; margin: 1.5rem 0; overflow-x: auto; width: 100%; }
  :global(.article-content th), :global(.article-content td) { border: 1px solid #2a3a50; padding: .65rem .8rem; text-align: right; }
  :global(.article-content th) { background: #111b2b; color: #fff; }
  :global(.article-content blockquote) { border-right: 3px solid #f59e0b; color: #d8c99e; margin: 1.5rem 0; padding: .5rem 1rem; }
  @media (max-width: 640px) {
    .article-content { font-size: 1rem; min-width: 0; }
    .article-page-header { padding-top: 0; }
    .article-page h1 { font-size: 1.75rem; overflow-wrap: anywhere; }
    :global(.article-content pre),
    :global(.article-content pre code),
    :global(.article-content pre span) {
      max-width: 100%;
      min-width: 0;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    :global(.article-content pre) { width: 100%; box-sizing: border-box; overflow: hidden !important; contain: inline-size; }
    :global(.article-content pre > code) { display: block; width: 100% !important; box-sizing: border-box; overflow: hidden; }
    :global(.article-content pre code span) { max-width: 100%; overflow-wrap: anywhere; word-break: break-word; }
    :global(.article-content table) { font-size: .78rem; table-layout: fixed; }
    :global(.article-content th),
    :global(.article-content td) { overflow-wrap: anywhere; word-break: break-word; padding: .45rem .35rem; }
  }
</style>

<script is:inline>
  const articlePage = document.querySelector('[data-article-page]');
  const syncArticleLanguage = (language) => {
    if (!articlePage || !['tr', 'en', 'ar'].includes(language)) return;
    articlePage.setAttribute('lang', language);
    articlePage.setAttribute('dir', language === 'ar' ? 'rtl' : 'ltr');
    articlePage.querySelectorAll('[data-content-language]').forEach((element) => {
      element.hidden = element.dataset.contentLanguage !== language;
    });
    articlePage.querySelectorAll('[data-tr][data-en][data-ar]').forEach((element) => {
      element.textContent = element.getAttribute(`data-${language}`);
    });
    articlePage.querySelectorAll('[data-date-tr][data-date-en][data-date-ar]').forEach((element) => {
      element.textContent = element.getAttribute(`data-date-${language}`);
    });
    const articleTitle = articlePage.querySelector('h1');
    if (articleTitle) document.title = `${articleTitle.textContent} — Hasan Mahmud`;
  };

  try {
    syncArticleLanguage(new URLSearchParams(window.location.search).get('lang') || localStorage.getItem('hm-lang') || 'ar');
  } catch (error) {
    syncArticleLanguage('ar');
  }

  window.addEventListener('languagechange', (event) => syncArticleLanguage(event.detail));
</script>
